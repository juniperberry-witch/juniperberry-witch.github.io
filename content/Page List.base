filters:
  and:
    - bookmarked == true
views:
  - type: table
    name: Basic View
    groupBy:
      property: type
      direction: ASC
    order:
      - file.name
      - description
    sort:
      - property: year
        direction: DESC
    columnSize:
      note.tags: 301
    rowHeight: medium
  - type: table
    name: Deity View
    groupBy:
      property: type
      direction: ASC
    order:
      - file.name
      - deities and spirits
    sort:
      - property: year
        direction: DESC
  - type: table
    name: Topics View
    groupBy:
      property: type
      direction: ASC
    order:
      - file.name
      - topics
    sort:
      - property: topics
        direction: ASC
      - property: year
        direction: DESC
  - type: table
    name: Articles
    filters:
      and:
        - file.tags.contains("Article")
    order:
      - file.name
      - chapters
      - type
